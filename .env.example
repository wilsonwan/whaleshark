# Optional: source-build configuration.
# `cp .env.example .env` supplies these to local builds. These are public
# identifiers, not secrets. Do not add server-side secrets to this file.

# Optional: signed macOS builds. The Apple Team ID and a provisioning profile
# with Associated Domains are needed only when signing and notarizing the
# desktop app locally. Without them the desktop app still builds, unsigned.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
